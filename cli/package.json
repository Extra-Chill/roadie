{
  "name": "@extrachill/roadie",
  "module": "index.ts",
  "type": "module",
  "version": "0.40.0",
  "scripts": {
    "dev": "tsx src/bin.ts",
    "prepublishOnly": "pnpm build",
    "build": "rm -rf dist && pnpm generate && pnpm tsc",
    "watch": "tsx scripts/watch-session.ts",
    "generate": "pnpm generate:sql",
    "pack:release": "tsx scripts/pack-release.ts",
    "generate:sql": "tsx scripts/generate-schema-sql.ts",
    "test": "vitest",
    "validate-typing-indicator": "doppler run -- tsx scripts/validate-typing-indicator.ts",
    "test:send": "tsx send-test-message.ts",
    "register-commands": "tsx scripts/register-commands.ts",
    "lint": "lintcn lint",
    "format": "oxfmt src"
  },
  "repository": "https://github.com/Extra-Chill/roadie",
  "bin": {
    "roadie": "bin.js"
  },
  "exports": {
    "./package.json": "./package.json",
    "./anthropic-auth-plugin": {
      "types": "./dist/anthropic-auth-plugin.d.ts",
      "default": "./dist/anthropic-auth-plugin.js"
    }
  },
  "files": [
    "dist",
    "src",
    "bin.js"
  ],
  "devDependencies": {
    "@types/bun": "latest",
    "@types/heic-convert": "^2.1.0",
    "@types/json-schema": "^7.0.15",
    "@types/ms": "^2.1.0",
    "@types/node": "^24.3.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/ws": "^8.18.1",
    "discord-digital-twin": "workspace:^",
    "slack-digital-twin": "workspace:^",
    "drizzle-kit": "1.0.0-beta.22",
    "eventsource-parser": "^3.0.6",
    "lintcn": "^0.7.1",
    "opencode-cached-provider": "workspace:^",
    "opencode-deterministic-provider": "workspace:^",
    "tsx": "^4.20.5",
    "undici": "^8.0.2"
  },
  "dependencies": {
    "@slack/web-api": "^7.17.0",
    "@clack/prompts": "^1.3.0",
    "@libsql/client": "^0.17.2",
    "@opencode-ai/plugin": "^1.16.2",
    "@opencode-ai/sdk": "^1.16.2",
    "@subrouter/cli": "0.6.1",
    "@subrouter/opencode": "0.5.1",
    "cron-parser": "^5.5.0",
    "diff": "^8.0.4",
    "discord.js": "^14.26.3",
    "domhandler": "^6.0.1",
    "drizzle-orm": "1.0.0-beta.22",
    "errore": "^0.14.1",
    "goke": "^6.9.0",
    "htmlparser2": "^12.0.0",
    "kitty-graphics-agent": "^0.0.5",
    "libsql": "^0.5.22",
    "libsqlproxy": "^0.1.0",
    "marked": "^17.0.5",
    "mime": "^4.1.0",
    "opencode-injection-guard": "^0.2.1",
    "picocolors": "^1.1.1",
    "pretty-ms": "^9.3.0",
    "proper-lockfile": "^4.1.2",
    "string-dedent": "^3.0.2",
    "ws": "^8.19.0",
    "xdg-basedir": "^5.1.0",
    "yaml": "^2.8.3",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "optionalDependencies": {
    "@snazzah/davey": "^0.1.10",
    "heic-convert": "^2.1.0",
    "sharp": "^0.34.5"
  }
}
