{
  "name": "roadie-workspace",
  "version": "0.49.0",
  "private": true,
  "files": [],
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "prepare": "pnpm -r --filter discord-slack-bridge run build",
    "test": "pnpm run generate && pnpm --filter @extrachill/roadie exec env NODE_ENV=test vitest run --exclude '**/*.e2e.test.ts'",
    "dev": "pnpm --filter @extrachill/roadie dev",
    "roadie": "pnpm --filter @extrachill/roadie play",
    "release:package": "bash scripts/release-package.sh",
    "test:all": "pnpm --filter @extrachill/roadie exec env NODE_ENV=test vitest",
    "generate": "pnpm --filter discord-digital-twin --filter slack-digital-twin --filter @extrachill/roadie run generate"
  },
  "devDependencies": {
    "oxfmt": "^0.24.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.4",
    "vite-node": "^3.2.4",
    "vitest": "^3.2.4"
  },
  "repository": "https://github.com/remorses/",
  "author": "remorses <beats.by.morse@gmail.com>",
  "license": "",
  "dependencies": {
    "@opencode-ai/sdk": "^1.15.11",
    "string-dedent": "^3.0.2",
    "tiny-jsonc": "^1.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@discordjs/opus"
    ],
    "overrides": {},
    "packageExtensions": {
      "@holocron.so/vite": {
        "peerDependencies": {
          "spiceflow": "*"
        }
      },
      "spiceflow": {
        "peerDependencies": {
          "vite": "*"
        }
      }
    }
  }
}
